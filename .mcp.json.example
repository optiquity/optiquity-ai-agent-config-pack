{
  "_readme": "Copy this to .mcp.json and set BASE_DIR to the absolute path of this repo. .mcp.json is gitignored — never commit it.",
  "mcpServers": {
    "local-rag": {
      "command": "npx",
      "args": ["-y", "mcp-local-rag"],
      "env": {
        "_readme": "Set BASE_DIR to the absolute path of the pack repo root. RAG index is stored in .claude/rag-index/ (gitignored).",
        "BASE_DIR": "/absolute/path/to/dhs-ai-agent-config-pack",
        "DB_PATH": "./.claude/rag-index",
        "CACHE_DIR": "./.claude/rag-cache"
      }
    }
  }
}
