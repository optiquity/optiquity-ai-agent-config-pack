{
  "_readme": "Copy this to .mcp.json and fill in your real values. .mcp.json is gitignored — never commit it.",
  "mcpServers": {
    "xcode": {
      "command": "echo",
      "args": [
        "Replace this example with your real Xcode MCP server command"
      ]
    },
    "local-rag": {
      "command": "npx",
      "args": ["-y", "mcp-local-rag"],
      "env": {
        "_readme": "Set BASE_DIR to the absolute path of this project. Used by /pm-startup skill for semantic search over METHODOLOGY.md and PROMPT-TEMPLATES.md. See supporting-docs/CLI-PM-SETUP.md.",
        "BASE_DIR": "/absolute/path/to/your/project",
        "DB_PATH": "./.claude/rag-index",
        "CACHE_DIR": "./.claude/rag-cache"
      }
    }
  }
}
