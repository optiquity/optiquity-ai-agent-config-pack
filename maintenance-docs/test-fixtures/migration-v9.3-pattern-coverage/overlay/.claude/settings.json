{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(xcodebuild *)",
      "Bash(swift test *)",
      "Bash(swift build *)",
      "Bash(swift format *)",
      "Bash(buf *)",
      "Bash(uv *)",
      "Bash(ruff *)",
      "Bash(pyright *)",
      "Bash(pytest *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(./scripts/*)",
      "Bash(./agent-run.sh *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/agent-post-edit-check.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "AGENT_CAPABILITIES": "planning,architecture,implementation,refactoring,debugging,testing,review,dependency-review,repo-ops,documentation",
    "XCODE_SCHEME": "FIXTURE-SCHEME-MARKER",
    "XCODE_DESTINATION": ""
  }
}
