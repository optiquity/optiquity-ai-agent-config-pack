# tracker.toml — pack repo tracker configuration (example)
#
# This file is OPTIONAL. Without it, the pack runs in flat-file mode
# (the /backlog/ + /changelog/ per-entry trees as source-of-truth;
# the pack has no monolith mirror files post-BD-203).
#
# LOCAL OPT-IN MODEL (BD-204). Tracker mode is a per-checkout LOCAL
# opt-in: the live `tracker.toml` you create from this example is
# LOCAL and gitignored (root-anchored `/tracker.toml` rule) — it is
# NEVER committed, so your mode survives pulls and version bumps, and
# no one else's checkout changes. The repo's COMMITTED state is
# always flat-file: every checkout and every version bump ships
# flat-file. While opted in, the committed /backlog/ tree is the
# PUBLISHED flat-file SSOT kept current via `pack tracker
# tree-rebuild` + the normal commit gates; single-writer caveat in
# /backlog/_rules.md § "Source of truth".
#
# To enable tracker mode for the pack repo (locally):
#   1. Copy this file to `tracker.toml` in the pack root (your
#      checkout only — the copy is gitignored, never committed).
#   2. Edit `mode.state = "tracker"`.
#   3. Run the forward migration script (see ARCHITECTURE.md §6).
#   4. The migration will set `migration.forward_complete = true`,
#      after which `tracker_mode()` resolves to "tracker".
#
# Read by scripts/lib/tracker-config.sh; spec: ARCHITECTURE.md §3.1.

schema_version = 1

[backend]
# Supported at v11.0: "github". Others (linear, jira, redmine) reserved.
name = "github"
# Org/repo slug. Required for GH-backed installs.
repo = "DShaneNYC/optiquity-ai-agent-config-pack"
# host = "github.com"             # set for GitHub Enterprise
# instance = ""                    # set for jira: full URL

[mode]
# "tracker"   = use tracker as source-of-truth ON THIS CHECKOUT; the
#               per-entry trees + _toc.md regenerate from tracker
#               state (no monolith mirrors on the pack surface
#               post-BD-203). The mode is local (gitignored file) —
#               the committed repo stays flat-file regardless.
# "flat-file" = pre-v11 behavior; tracker.toml present but disabled.
state = "flat-file"
# Set when first switching to tracker mode (ISO 8601 UTC).
# opted_in_at = "2026-05-15T12:00:00Z"
# opted_in_by = "you@example.com"

# NO [mirror] table on the pack surface (BD-204, completing BD-203's
# no-monolith repoint). The pack deleted its monolith mirrors at
# BD-203 — the /backlog/ + /changelog/ per-entry trees (with
# regenerated _toc.md) are the sole flat representation, and _toc.md
# regeneration is not a "mirror file" in the Check 29 sense.
# validate-pack.py treats the absent table as a no-mirror surface
# (mirror-staleness N/A). The client-side example
# (project-template/tracker.toml.project-example) likewise omits the
# [mirror] table — no surface keeps a monolith mirror.

[id_namespace]
# "BD" for the pack repo; "TD" for client projects.
prefix = "BD"

[cli_acceleration]
# Prefer gh CLI vs MCP for tracker ops:
#   "gh"   = always shell out to gh
#   "mcp"  = always use MCP if configured
#   "auto" = MCP if configured for the active CLI, else gh
prefer = "gh"

[migration]
# Set true once forward migration to tracker is complete. Until then,
# tracker_mode() returns "flat-file" even when state = "tracker".
forward_complete = false
# Set true once a reverse migration script run has been verified.
reverse_available = false
# Set on each successful migration run (ISO 8601 UTC).
# last_forward_run = "2026-05-15T12:00:00Z"
# last_reverse_run = "2026-05-20T08:00:00Z"
# Local mapping file (gitignored). Tracker IDs <-> pack IDs.
mapping_file = ".pack-tracker/id-map.json"

# [graph]
# Cross-entity dependency graph tuning (V3.3 §5.5; BD-108).
# K-hop bound for the link-creation cycle check. Default is 10 if
# this section/key is absent. Raise to detect longer cycles at the
# cost of broader graph traversal per link attempt.
# cycle_check_k = 10  # K-hop bound for link-creation cycle check (V3.3 §5.5)
