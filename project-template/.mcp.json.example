{
  "_readme": "Copy this to .mcp.json and fill in your real values. .mcp.json is gitignored — never commit it.",
  "_tools": "mcp-local-rag is recommended for Claude Code CLI PM chat sessions. It provides semantic search over METHODOLOGY.md and PROMPT-TEMPLATES.md. Not needed for Gemini CLI (GEMINI.md hierarchy provides native context) or Codex CLI.",
  "mcpServers": {
    "local-rag": {
      "command": "npx",
      "args": ["-y", "mcp-local-rag"],
      "env": {
        "_readme": "Set BASE_DIR to the absolute path of this project. See supporting-docs/CLI-PM-SETUP.md for setup instructions.",
        "BASE_DIR": "/absolute/path/to/your/project",
        "DB_PATH": "./.claude/rag-index",
        "CACHE_DIR": "./.claude/rag-cache"
      }
    }
  }
}
