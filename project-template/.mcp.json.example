{
  "_readme": "Copy this to .mcp.json and fill in your real values. .mcp.json is gitignored — never commit it.",
  "_tools": "mcp-local-rag is recommended for Claude Code CLI PM chat sessions. It provides semantic search over METHODOLOGY.md. Gemini CLI CAN also use this MCP local-RAG server (its mcpServers block accepts the same stdio server; Gemini's successor Antigravity preserves MCP, relocating the mcpServers block from settings.json to a dedicated mcp_config.json — exact path per Antigravity migration docs — with the stdio command/args/env shape unchanged); whether RAG is NEEDED for Gemini is the open point, since the GEMINI.md hierarchy already supplies native context. Codex CLI CAN also use this MCP local-RAG server (.codex/config.toml.example ships a commented [mcp_servers.local-rag] block); whether RAG is NEEDED for Codex is the open point.",
  "mcpServers": {
    "local-rag": {
      "command": "npx",
      "args": ["-y", "mcp-local-rag"],
      "env": {
        "_readme": "Set BASE_DIR to the absolute path of this project.",
        "BASE_DIR": "/absolute/path/to/your-project",
        "DB_PATH": "./.claude/rag-index",
        "CACHE_DIR": "./.claude/rag-cache"
      }
    }
  }
}
