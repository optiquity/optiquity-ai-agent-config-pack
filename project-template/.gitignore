# ─── Agent local overrides ─────────────────────────────────────────────────
.claude/settings.local.json
.mcp.json
.claude/rag-index/
.claude/rag-cache/

# ─── Tracker-mode local state (BD-061) ─────────────────────────────────────
# Mapping file, migration checkpoints, and reverse-migration sidecars.
# Never committed: contains local paths and is regenerable from the tracker.
.pack-tracker/

# ─── Secrets and credentials ───────────────────────────────────────────────
.env
.env.*
# But .env.example is a committed template (no secrets); always tracked.
!.env.example
*.secret
*.secrets
secrets/
*.pem
*.p12
*.mobileprovision
GoogleService-Info.plist

# ─── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Xcode and Swift ───────────────────────────────────────────────────────
DerivedData/
.build/
build/
Packages/
Package.resolved
*.xcuserstate
xcuserdata/
*.moved-aside
*.xccheckout
*.xcscmblueprint
*.xcworkspace/xcuserdata/
*.xcworkspace/xcshareddata/

# ─── Test and coverage artifacts ───────────────────────────────────────────
xcresult/
*.xcresult
coverage/
coverage.xml
htmlcov/

# ─── Generated Protobuf / gRPC (Swift) — regenerate via scripts/proto-gen.sh ──
# Only commit generated code if your build system cannot run buf at build time.
generated/swift/
Sources/Generated/
**/Generated/*.pb.swift
**/Generated/*.grpc.swift

# ─── buf CLI cache ─────────────────────────────────────────────────────────
.buf/

# ─── Python tooling (if scripts use Python) ────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/

# ─── Additional Xcode artifacts ─────────────────────────────────────────────
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcuserstate
*.xccheckout
*.xcscmblueprint

# ─── Xcode mode/perspective files (keep defaults, ignore user-specific) ─────
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# ─── Playgrounds ─────────────────────────────────────────────────────────────
timeline.xctimeline
playground.xcworkspace

# ─── Fastlane ─────────────────────────────────────────────────────────────────
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ─── Carthage ─────────────────────────────────────────────────────────────────
Carthage/Build/
