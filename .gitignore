# ── Machine-local Claude overrides ──────────────────────────────────────────
# May contain local paths or tokens — never commit
.claude/settings.local.json

# ── Sub-agent worktree checkouts ───────────────────────────────────────────
# Isolated per-agent worktrees materialized here by sub-agent worktree
# isolation. Each is a full second checkout, transient and machine-local —
# never committed. Scoped to the `worktrees/` subdirectory on purpose: the
# tracked `.claude/agents/`, `.claude/skills/`, and `.claude/settings.json`
# entries must stay tracked.
.claude/worktrees/

# ── Machine-local MCP config ─────────────────────────────────────────────────
# May contain API keys or local server paths — never commit
.mcp.json

# ── Playwright MCP session artifacts ─────────────────────────────────────────
# Console logs and page snapshots written by the Playwright MCP server.
# Side-effect output of MCP tool calls, not part of the pack product.
.playwright-mcp/

# ── Tracker-mode local state (BD-061) ───────────────────────────────────────
# Mapping file, migration checkpoints, and reverse-migration sidecars.
# Never committed: contains local paths and is regenerable from the tracker.
.pack-tracker/
# Local tracker-mode opt-in (BD-204): the repo's committed state is always
# flat-file; your local mode survives pulls. ROOT-ANCHORED on purpose — the
# committed test fixtures named tracker.toml deeper in the tree
# (scripts/tests/fixtures/**/tracker.toml) must stay tracked.
/tracker.toml

# ── Pack operating-mode config (BD-224) ───────────────────────────────────
# Per-clone runtime mode selections; orchestrator-read-only. Never committed
# (session-state.json stays committed; only this sibling config is local).
pack-ops/session-config.json
# Single-use commit-approval token the intervention_mode commit-gate consumes.
# Per-clone, orchestrator-written at the approval gate; transient. Never committed.
pack-ops/.commit-approval-token

# ── Generated Protobuf output ─────────────────────────────────────────────────
# Regenerate with scripts/proto-gen.sh
generated/
**/generated/swift/
**/generated/python/

# ── iOS 26 API reference docs ─────────────────────────────────────────────────
# Agents read directly from the Xcode bundle — no local sync needed.
# Entry kept in case a developer manually creates this directory.
shared-docs/ios26/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
._*

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
# Exception: synthetic test fixtures intentionally ship .env files
# (BD-096; reproducibility from a fresh clone requires them in git)
!scripts/tests/fixtures/**/.env
dist/
build/

# ── Swift / Xcode ─────────────────────────────────────────────────────────────
*.xcuserstate
xcuserdata/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# ── Editor ────────────────────────────────────────────────────────────────────
*.swp
*.swo
.vscode/
# Exception: the VS Code companion template files are intentionally committed
!vscode-companion-templates/.vscode/
!vscode-companion-templates/.vscode/**
.idea/

# ── BD-119 pre-refactor monolith snapshot ─────────────────────────────────────
# Captured before the migrate-v10-to-v11.sh refactor; consumed by the
# behavior-preservation harness. Lives only on the implementer's working
# tree. Never committed; recreate from a pre-refactor commit if needed.
scripts/.bd119-pre-refactor-monolith.sh.snapshot

# ── Graphify knowledge-graph build artifact (BD-225) ─────────────────────────
# Per-clone, regenerated; never committed (CI Check 63 enforces). Includes
# graph.json, GRAPH_REPORT.md, graph.html, cache/, cost.json, memory/, needs_update.
graphify-out/
